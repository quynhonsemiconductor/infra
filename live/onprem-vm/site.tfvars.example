# ── Site values for live/onprem-vm ──────────────────────────────────────────
#
# Copy to site.tfvars (git-ignored) and change THAT file for a new site:
#
#   cp site.tfvars.example site.tfvars
#   chmod 600 site.tfvars
#
# Nothing here is a credential: the Proxmox endpoint and API token are
# environment variables (TF_VAR_proxmox_*), so this file can be copied between
# sites without carrying access. The VLAN tag is REQUIRED — it is site
# topology, which this public repo does not carry.

proxmox_node        = "pve01"
proxmox_ssh_address = "192.0.2.10"

vm_id   = 100
vm_name = "k3s-01"

datastore_id = "local-zfs"

vm_cores     = 28
vm_memory_mb = 24576

os_disk_gb   = 120
data_disk_gb = 1200

bridge = "vmbr0"

# The tag `qm config 100` shows as tag=<n> on net0. Replace before applying:
# 0 means "untagged", which would move a tagged node.
# vlan_id = 10   # only when net0 carries a tag; the live k3s-01 has none

# ── ai-01 (GPU agent node) ────────────────────────────────────────────────
ai01_vm_id     = 101
ai01_vm_name   = "ai-01"
ai01_cores     = 8
ai01_memory_mb = 12288
ai01_data_disk_gb = 300
# The GPU node's address on the same VLAN (replace: 192.0.2.x is documentation).
k3s01_ipv4_address = "192.0.2.20/24"
ai01_ipv4_address  = "192.0.2.21/24"
ipv4_gateway      = "192.0.2.1"
dns_servers       = ["192.0.2.1"]

# ── vlsi-01 (EDA / JupyterLab workspaces, Phase 3) ─────────────────────────
# Next free address after ai-01 on the same VLAN (replace: 192.0.2.x is documentation).
vlsi01_ipv4_address = "192.0.2.22/24"

# Operator keys for the cloud-init user of ai-01 and vlsi-01 (public halves only).
ssh_public_keys = [
  "ssh-ed25519 AAAA... owner@laptop",
]

# ── PBS (backup.tf) ─────────────────────────────────────────────────────────
# Certificate fingerprint as `ansible-playbook pve-host.yml --tags pbs` prints it (not a secret).
pbs_fingerprint = "00:11:22:33:44:55:66:77:88:99:aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99:aa:bb:cc:dd:ee:ff"

# ── PVE metrics (metrics.tf) ────────────────────────────────────────────────
# A k3s node address that serves the Alloy OTLP NodePort; "" = no metric server.
pve_metrics_otlp_server = "192.0.2.20"
