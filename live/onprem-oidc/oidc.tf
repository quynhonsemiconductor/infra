# ── The cluster's public OIDC issuer (ONPREM-PLAN §5.1, §7.1) ───────────────
#
# Entra's federated identity credential (live/identity/eso.tf) trusts tokens
# whose `iss` is this issuer. To validate one, Entra fetches, over the public
# internet:
#
#   <issuer>/.well-known/openid-configuration    the discovery document
#   <issuer>/openid/v1/jwks                      the keys in that document
#
# k3s serves both on the cluster network (the API server); neither is
# reachable from Entra. So the same two documents are published here.
#
# WHY A WORKER AND NOT R2/Pages: the Cloudflare provider (v5) has no resource
# that uploads an object to R2 and none that deploys a Pages project — either
# would need `wrangler` plus a token at apply time, i.e. a by-hand step for
# content the cluster already knows. A Worker carries the documents as
# Terraform values, so refreshing the JWKS is `TF_VAR_k3s_jwks=… tofu apply`
# and nothing else.
#
# WHAT IS SERVED IS PUBLIC. The JWKS is the public half of the service-account
# signing key; static tests and review treat it as public data, not a secret.
#
# NOT YET INVOLVED: no DNS record or certificate is created by hand —
# cloudflare_workers_custom_domain provisions both.

locals {
  issuer = "https://${var.oidc_hostname}/${var.oidc_path}"
  jwks   = jsondecode(var.k3s_jwks)

  # Shape of the document the k3s API server serves itself (verified against
  # /openid/v1/jwks + /.well-known/openid-configuration on k3s-01). The issuer
  # is overridden to the public URL; the oidc discovery spec puts the
  # well-known segment AFTER the path for an issuer that has one.
  discovery = {
    issuer                                = local.issuer
    jwks_uri                              = "${local.issuer}/openid/v1/jwks"
    response_types_supported              = ["id_token"]
    subject_types_supported               = ["public"]
    id_token_signing_alg_values_supported = ["RS256"]
  }

  documents = {
    "/${var.oidc_path}/.well-known/openid-configuration" = local.discovery
    "/${var.oidc_path}/openid/v1/jwks"                   = local.jwks
  }

  worker = <<-JS
    // Generated by infra/live/onprem-oidc — do not edit in the Cloudflare
    // dashboard; the next apply overwrites it.
    const DOCUMENTS = ${jsonencode(local.documents)};

    export default {
      async fetch(request) {
        const { pathname } = new URL(request.url);
        if (!Object.hasOwn(DOCUMENTS, pathname)) {
          return new Response("not found\n", { status: 404 });
        }
        return new Response(JSON.stringify(DOCUMENTS[pathname]), {
          headers: {
            "content-type": "application/json",
            // Entra caches keys; five minutes keeps a rotation visible quickly
            // without making every token exchange a fetch.
            "cache-control": "public, max-age=300",
          },
        });
      },
    };
  JS
}

resource "cloudflare_workers_script" "oidc" {
  account_id         = var.cloudflare_account_id
  script_name        = var.worker_name
  content            = local.worker
  main_module        = "worker.js"
  compatibility_date = "2026-10-01"
}

resource "cloudflare_workers_custom_domain" "oidc" {
  account_id = var.cloudflare_account_id
  zone_id    = var.cloudflare_zone_id
  hostname   = var.oidc_hostname
  service    = cloudflare_workers_script.oidc.script_name
}

output "issuer" {
  description = "The issuer URL. MUST equal var.eso_oidc_issuer in live/identity and service-account-issuer in live/onprem-vm/files/k3s/config.yaml."
  value       = local.issuer
}

output "documents" {
  description = "The two paths served (for a curl check)."
  value       = sort(keys(local.documents))
}
