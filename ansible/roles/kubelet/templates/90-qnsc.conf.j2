---
# Merge settings (the drop-in is merged over k3s's generated KubeletConfiguration).
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration

# System daemons get CPU and memory before pods; see defaults/main.yml for why.
systemReserved:
  cpu: "{{ kubelet_profiles[kubelet_profile].cpu }}"
  memory: "{{ kubelet_profiles[kubelet_profile].memory }}"

evictionHard:
  memory.available: "500Mi"
  nodefs.available: "10%"
  nodefs.inodesFree: "5%"
  imagefs.available: "15%"

# kubelet may spend up to 120 s shutting pods down, 60 s of it on critical pods. Matches the
# server's previous hand-written drop-in and the host's NUT down_delay.
shutdownGracePeriod: 120s
shutdownGracePeriodCriticalPods: 60s

imageMaximumGCAge: "{{ kubelet_image_maximum_gc_age }}"

# Image garbage collection watermarks (see defaults/main.yml). Collection always runs above the high
# percent and never below the low one; the upstream default is 85/80, which let k3s-01's image store grow
# to ~91 GiB of a 120 GiB root before it ran at all.
imageGCHighThresholdPercent: {{ kubelet_image_gc_high_percent }}
imageGCLowThresholdPercent: {{ kubelet_image_gc_low_percent }}
