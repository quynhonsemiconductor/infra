#include <tunables/global>

# QNSC host override of containerd's default container profile (containerd 2.x template)
# plus the two stacked-peer rules from containerd PR #14487 (issue #14485).
# Why: on Ubuntu 26.04 (kernel.apparmor_restrict_unprivileged_unconfined=1) container processes are labelled
# "cri-containerd.apparmor.d//&unconfined"; the stock rules only match the plain label, so signals and ptrace
# between processes of the SAME container are denied (incident 2026-11-03: PostgreSQL latches/SIGURG, logins hung).
# containerd skips loading its own profile when one with this name is already loaded.
# Remove this override once the bundled containerd (k3s) ships #14487 or an equivalent.
profile cri-containerd.apparmor.d flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,
  # Host (privileged) processes may send signals to container processes.
  signal (receive) peer=unconfined,
  # runc may send signals to container processes.
  signal (receive) peer=runc,
  # crun may send signals to container processes.
  signal (receive) peer=crun,
  # Manager may send signals to container processes.
  signal (receive) peer=cri-containerd.apparmor.d,
  # Container processes may send signals amongst themselves.
  signal (send,receive) peer=cri-containerd.apparmor.d,
  # QNSC: the same, for the stacked label (containerd #14487).
  signal (send,receive) peer=cri-containerd.apparmor.d//&*,

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny mount,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # suppress ptrace denials when using 'docker ps' or using 'ps' inside a container
  ptrace (trace,read,tracedby,readby) peer=cri-containerd.apparmor.d,
  # QNSC: the same, for the stacked label (containerd #14487).
  ptrace (trace,read,tracedby,readby) peer=cri-containerd.apparmor.d//&*,
}
