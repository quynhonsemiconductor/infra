# {{ qnsc_ansible_managed }}
[Unit]
Description=Write Proxmox host ZFS/NVMe/PBS gauges for node-exporter
After=local-fs.target
Documentation=https://github.com/quynhonsemiconductor/infra

[Service]
Type=oneshot
ExecStart={{ pve_monitoring_script }}
User=root
Group=root
# zpool/smartctl/proxmox-backup-manager failures are handled inside the script
# (each command has its own `timeout`); this is the outer bound, so a wedged
# unit can never leave the timer's next tick queued behind it.
# 180 s >= the worst-case sum of the inner timeouts: zpool 20 + smartctl 20 per
# NVMe (2 disks = 40) + PBS datastore 20 + PBS task list 30 + apt 20 = 130 s,
# plus the final `find /boot` — 50 s of headroom.
TimeoutStartSec=180s
Nice=10
# The script needs root only to read SMART/PBS/ZFS. It writes exactly one
# directory, so give it read-only everything else and no new privileges.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths={{ pve_monitoring_textfile_dir }}
