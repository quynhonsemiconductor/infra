# OpenTofu / Terraform provider cache — never commit cached binaries
**/.terraform/

# State files — stored in S3 backend, never commit locally
*.tfstate
*.tfstate.*
*.tfstate.backup

# NOTE: .terraform.lock.hcl IS committed — it pins provider versions.
# Do NOT add it here.

# Plan output binaries — contain serialised secrets, never commit
*.tfplan
tfplan

# Sensitive var files — use *.tfvars.example for safe templates
*.tfvars
!*.tfvars.example

# Partial backend config files (may contain credentials)
*.tfbackend

# Local override files — developer-only, never shared
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# OpenTofu / Terraform crash logs
crash.log
crash.*.log

# CLI config files (contain tokens / credentials)
.terraformrc
.terraform.rc

# Logs
*.log
logs/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json
*.swp

# Python bytecode from running scripts/ locally
__pycache__/
*.pyc

# Committed plan JSON (tofu show -json) carries the prior state, session ARNs and secrets: never commit it
plan.json

# Entra app-registration audit output (scripts/entra-audit): tenant data. The scripts write it OUTSIDE the repo
# (default ~/entra-audit-<date>/) and refuse a directory inside one; these patterns catch an accidental copy.
entra-audit-*/
entra-audit-report.md
entra-audit-report.json
**/graph.json
**/exchange.json
